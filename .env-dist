# ===================================================================
# theses-batch : Variables d'environnement
# ===================================================================

# -------------------------------------------------------------------
# Répertoires
# -------------------------------------------------------------------
# Répertoire des exports et des logs dans le conteneur
OUTPUT_DIR=/output
# La base H2 de Spring Batch (historique des exécutions, règle des 6 mois) est dans /data/batchdb :
# /data doit être un volume persistant (voir docker-compose du dépôt theses-batch-docker)

# -------------------------------------------------------------------
# Configuration Docker & Planification Cronie (Abes, toujours activée)
# -------------------------------------------------------------------

# Expressions Cron pour chaque batch
# Format : minute heure jour_du_mois mois jour_de_semaine
# Datagouv : Tous les jours à 2h00 du matin (évaluation automatique de la règle des 6 mois)
THESES_BATCH_DATAGOUV_CRON=0 2 * * *

# Mémoire JVM (ex: 6g pour 8 threads ANR, 2g pour Datagouv)
THESES_BATCH_JAVA_XMX=6g
THESES_BATCH_HEAP_DUMP_DIR=/output
THESES_BATCH_JAVA_OPTS=

# OpenTelemetry (agent Java désactivé par défaut ; true pour l'activer)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=theses-batch
OTEL_ENVIRONMENT=local
OTEL_NAMESPACE=theses
OTEL_VERSION=latest
OTEL_RESOURCE_ATTRIBUTES=service.name=${OTEL_SERVICE_NAME},deployment.environment=${OTEL_ENVIRONMENT},service.namespace=${OTEL_NAMESPACE},host.name=${HOSTNAME},service.version=${OTEL_VERSION}
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp

# -------------------------------------------------------------------
# Paramètres du Batch ANR
# -------------------------------------------------------------------
THESES_BATCH_ANR_PATTERN=ANR-(?:\d{2}-)?[A-Za-z0-9]{4,8}(?:-\d{1,4})?|Agence nationale de la recherche|Labex|\bPIA\b
THESES_BATCH_ANR_MAX_FILES=10000
THESES_BATCH_ANR_OFFSET=0
THESES_BATCH_ANR_NB_PAGES=50
THESES_BATCH_ANR_CONTEXT_CHARACTERS=50
THESES_BATCH_ANR_CHUNK_SIZE=500
THESES_BATCH_ANR_EXCLUDE_KEYWORDS=annexe,resume,résumé,abstract,errata,summary,erratum,annexes,appendix,appendices,titre,couverture,couv,cover,synthese,synthèse,glossaire,illustr,diff,image,table,sommaire,garde,planche,annnexe,annex_
THESES_BATCH_ANR_SCAN_THREADS=8
THESES_BATCH_ANR_PROCESS_THREADS=8
THESES_BATCH_ANR_START_FILE=
THESES_BATCH_ANR_PROGRESS_INTERVAL=30s
THESES_BATCH_ANR_FONTS_DIR=/usr/share/fonts
THESES_BATCH_ANR_WRITERS_ENABLED=csv,json
THESES_BATCH_ANR_WRITERS_HEADER=page_number,match_value,preceding_context,following_context,nnt,doi,defense_date
THESES_BATCH_ANR_JSON_PRETTY_PRINT=true

# Serveur Solr (pour enrichissement ANR)
THESES_BATCH_SOLR_ENABLED=true
THESES_BATCH_SOLR_BASE_URL=
THESES_BATCH_SOLR_ID_FIELD=id
THESES_BATCH_SOLR_NNT_FIELD=nnt
THESES_BATCH_SOLR_DOI_FIELD=doi
THESES_BATCH_SOLR_DEFENSE_DATE_FIELD=dateSoutenance_dt
THESES_BATCH_SOLR_CONNECT_TIMEOUT=5000
THESES_BATCH_SOLR_READ_TIMEOUT=5000

# -------------------------------------------------------------------
# Paramètres du Batch Datagouv (Dump des thèses soutenues)
# -------------------------------------------------------------------
# API theses.fr
THESES_API_BASE_URL=
THESES_PAGE_SIZE=1000

# API data.gouv.fr (téléversement)
# https://www.data.gouv.fr en production ; site de démonstration (jeux de données et clés propres) pour tester
DATA_GOUV_BASE_URL=https://demo.data.gouv.fr
DATA_GOUV_API_KEY=
DATA_GOUV_DATASET_ID=
DATA_GOUV_CSV_RESOURCE_ID=
DATA_GOUV_JSON_RESOURCE_ID=
DATA_GOUV_JSONL_RESOURCE_ID=
DATA_GOUV_JSONL_GZ_RESOURCE_ID=

# Contrôle du téléversement vers data.gouv.fr (true = envoi effectif, false = export local uniquement)
DATA_GOUV_UPLOAD_ENABLED=false
# Taille des morceaux d'envoi des gros fichiers (un seul morceau en mémoire à la fois)
DATA_GOUV_UPLOAD_CHUNK_SIZE=10MB

# Mode Test (true = limite l'export à 50 thèses et ignore la règle des 6 mois)
MODE_TEST=false

# Forçage du lancement manuel (contourne la règle des 6 mois)
FORCE_RUN=false
