<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration Log4j2 du batch.

  Le suffixe "-spring" du nom de fichier est requis : c'est lui qui autorise
  le lookup ${spring:...}, résolu sur l'Environment Spring Boot.

  ${date:...} est évalué une seule fois, au chargement de la configuration,
  donc chaque exécution du batch écrit dans son propre fichier horodaté.
-->
<Configuration status="WARN">

    <Properties>
        <Property name="outputDir">${spring:app.anr.output-dir:-output}</Property>
        <Property name="logPattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1.} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${logPattern}"/>
        </Console>
        <File name="BatchFile" fileName="${outputDir}/${date:yyyy-MM-dd-HH-mm-ss}_batch.log">
            <PatternLayout pattern="${logPattern}"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Les niveaux sont définis ici et nulle part ailleurs : une clé
             logging.level.* dans application.yml serait appliquée APRES ce
             fichier et masquerait toute modification faite ci-dessous.
             Pour un run ponctuel, passer la propriete logging.level.fr.theses.batch
             en argument de ligne de commande. -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="BatchFile"/>
        </Root>
    </Loggers>

</Configuration>
